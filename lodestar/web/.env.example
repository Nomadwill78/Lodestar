# Supabase project the Missive signup writes to (server-side route handler).
# Same project as the app. The anon key is safe to use here: the
# missive_subscribers table is RLS insert-only, so it cannot read the list.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Public site URL, used for Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=https://lodestar.app

# Stripe (paid plans on web). Server-only; never exposed to the browser.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_PRICE_ALIGNED_MONTHLY=price_...
STRIPE_PRICE_ALIGNED_ANNUAL=price_...
STRIPE_PRICE_FOUNDER_MONTHLY=price_...
STRIPE_PRICE_FOUNDER_ANNUAL=price_...
# The Stripe webhook secret is set on the Supabase stripe-webhook function,
# not here (supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...).
