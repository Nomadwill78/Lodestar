# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: paste values with NO leading/trailing whitespace and never from a
# file saved as "UTF-8 with BOM" — an invisible U+FEFF at the start of a value
# once broke all signups ("String contains non ISO-8859-1 code point").
# The app now strips such characters defensively (lib/env.ts), but keep values
# clean anyway.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic (Claude API) — used by /api/generate
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — used by /api/checkout and /api/stripe-webhook
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# Base URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://nomad-ad-generator.vercel.app
